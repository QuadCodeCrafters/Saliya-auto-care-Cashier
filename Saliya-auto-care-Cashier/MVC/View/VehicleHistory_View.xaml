<UserControl x:Class="Saliya_auto_care_Cashier.MVC.View.VehicleHistory_View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Saliya_auto_care_Cashier.MVC.View"
             mc:Ignorable="d">
    <materialDesign:Card UniformCornerRadius="15" 
                             Background="{DynamicResource MaterialDesignPaper}"
                             Margin="-1" materialDesign:ShadowAssist.ShadowDepth="Depth3">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <TextBlock Text="Vehicle Repair History" FontSize="27" FontWeight="SemiBold" 
                           Margin="18,10,0,0" HorizontalAlignment="Left"/>

            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Margin="40,50,70,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                                <TextBlock Text="Vehicle Number:" FontSize="17" FontWeight="SemiBold" 
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>

                                <TextBox x:Name="txtvehiclenum" 
                                                 Width="225" 
                                                 Height="55" 
                                                 FontSize="16" 
                                                 materialDesign:HintAssist.Hint="Enter The Vehicle Number" 
                                                 BorderThickness="2" 
                                                 BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}">

                                    <TextBox.Triggers>
                                        <EventTrigger RoutedEvent="TextBox.GotFocus">
                                            <BeginStoryboard Storyboard="{StaticResource ShakeAnimation}"/>
                                        </EventTrigger>
                                    </TextBox.Triggers>

                                </TextBox>
                            </StackPanel>
                            <Button Content="Search" Width="100" Height="40"
                                        Margin="260,10,10,0" Click="SearchButton_Click"/>

                        </StackPanel>

                        <Grid Grid.Column="1">
                            <StackPanel Margin="0,40,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Owner's Name :" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBox Width="250" IsReadOnly="True" FontSize="16" Margin="13,0,38,0"  x:Name="txtownername" />
                                    <TextBlock Text="Phone Number :" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBox Width="270" IsReadOnly="True" FontSize="16" Margin="13,0,0,0"  x:Name="txtownerphone" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,25,0,0">
                                    <TextBlock Text="Email :" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBox Width="320" IsReadOnly="True" FontSize="16" Margin="13,0,0,0"  x:Name="txtemail" />
                                    <TextBlock Text="Address :" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="38,0,0,0"/>
                                    <TextBox Width="325" IsReadOnly="True" FontSize="16" Margin="13,0,0,0"  x:Name="txtaddress" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,25,0,0">
                                    <TextBlock Text="Vehicle Model :" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBox Width="250" IsReadOnly="True" FontSize="16" Margin="13,0,0,0"  x:Name="txtmodel" />
                                    <TextBlock Text="Vehicle Type :" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="38,0,0,0"/>
                                    <TextBox Width="295" IsReadOnly="True" FontSize="16" Margin="13,0,0,0" x:Name="txtphone"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,25,0,0">
                                    <TextBlock Text="Registration Date:" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBox Width="230" IsReadOnly="True" FontSize="16" Margin="13,0,0,0" x:Name="txtregistrationdate"/>
                                    <TextBlock Text="Last Service Date :" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="38,0,0,0"/>
                                    <TextBox Width="260" IsReadOnly="True" FontSize="16" Margin="13,0,0,0" x:Name="txtlastservicedate"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="2" Margin="50,0,50,0">
                        <DataGrid x:Name="ServiceHistoryDataGrid" AutoGenerateColumns="False" 
                                  HorizontalAlignment="Stretch" Margin="0,-80,0,0"
                                  Height="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="*" />
                                <DataGridTextColumn Header="Service Type" Binding="{Binding ServiceType}" Width="*" />
                                <DataGridTextColumn Header="Mileage (in)" Binding="{Binding MileageIn}" Width="*" />
                                <DataGridTextColumn Header="Mileage (out)" Binding="{Binding MileageOut}" Width="*" />
                                <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </materialDesign:Card>
</UserControl>
