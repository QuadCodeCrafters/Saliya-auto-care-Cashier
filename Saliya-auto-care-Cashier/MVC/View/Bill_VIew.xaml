<UserControl x:Class="Saliya_auto_care_Cashier.MVC.View.Bill_VIew"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Saliya_auto_care_Cashier.MVC.View"
             mc:Ignorable="d"
             Background="White">
    <UserControl.Resources>
        <!-- Resources of SCROLLBARS-->
        <Style x:Key="ScrollThumbs" TargetType="{x:Type Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Grid x:Name="Grid">
                            <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="Auto" 
                                           Height="Auto" Fill="Transparent"/>
                            <Border x:Name="Rectangle1" CornerRadius="10 0 0 10" HorizontalAlignment="Stretch" 
                                        VerticalAlignment="Stretch" Width="Auto" Height="Auto" 
                                        Background="{TemplateBinding Background}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Horizontal">
                                <Setter TargetName="Rectangle1" Property="Width" Value="Auto"/>
                                <Setter TargetName="Rectangle1" Property="Height" Value="7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}">
            <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
            <Setter Property="Foreground" Value="LightBlue"/>
            <Setter Property="Background" Value="DarkGray"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="GridRoot" Width="12" Background="{x:Null}">
                            <Track x:Name="PART_Track" Grid.Row="0" IsDirectionReversed="true" Focusable="False">
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Background="{TemplateBinding Foreground}" 
                                               Style="{DynamicResource ScrollThumbs}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="PageUp" Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="PageDown" Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger SourceName="Thumb" Property="IsMouseOver" Value="true">
                                <Setter Value="{DynamicResource ButtonSelectBrush}" 
                                            TargetName="Thumb" Property="Background"/>
                            </Trigger>
                            <Trigger SourceName="Thumb" Property="IsDragging" Value="true">
                                <Setter Value="{DynamicResource DarkBrush}" TargetName="Thumb" Property="Background"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="false">
                                <Setter TargetName="Thumb" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="GridRoot" Property="LayoutTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="-90"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="PART_Track" Property="LayoutTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="-90"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="Height" Value="12"/>
                                <Setter TargetName="Thumb" Property="Tag" Value="Horizontal"/>
                                <Setter TargetName="PageDown" Property="Command" Value="ScrollBar.PageLeftCommand"/>
                                <Setter TargetName="PageUp" Property="Command" Value="ScrollBar.PageRightCommand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1" Grid.Column="0">
        <Grid x:Name="Invoice">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="20,0,0,0">
                        <Image Source="/Images/saliyalogo.png"/>
                    </Grid>
                    <Grid Grid.Column="1">
                        <StackPanel Margin="-70,35,0,30">
                            <TextBlock Text="SALIYA MOTORS" FontSize="21" HorizontalAlignment="Center" FontWeight="Bold"/>
                            <TextBlock Text="1/300,KANDY ROAD,MILLAWA,KURUNAGALA" FontSize="13" HorizontalAlignment="Center"/>
                            <TextBlock Text="Phone:037-2222093 | Email: saliyamotors@gmail.com" FontSize="13" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
            <Rectangle Fill="Black" Height="1" Margin="5 2" Opacity="0.5" Grid.Row="0" VerticalAlignment="Bottom"/>
            <Grid Grid.Row="1">
                <Grid HorizontalAlignment="Stretch" Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Bill To :" FontSize="15" Margin="5" FontWeight="Bold"/>
                            <TextBlock Text="Name" FontSize="12" Margin="0,9,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Address" FontSize="12" Margin="50,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Vehicle :" FontSize="15" Margin="5" />
                            <TextBlock Text="Name" FontSize="12" Margin="0,9,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Vehicle ID:" FontSize="15" Margin="5" />
                            <TextBlock Text="Id" FontSize="12" Margin="0,9,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Invoice No: " FontSize="15" Margin="70,6,0,0" FontWeight="Bold"/>
                            <TextBlock Text="ID" FontSize="12" Margin="0,10,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Terminal ID : " FontSize="15" Margin="70,6,0,0" />
                            <TextBlock Text="ID" FontSize="12" Margin="0,10,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Date : " FontSize="15" Margin="70,3,0,0"/>
                            <TextBlock Text="Date" FontSize="12" Margin="0,7,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <Rectangle Fill="Black" Height="1" Opacity="0.5" VerticalAlignment="Bottom" Margin="20,0,20,0"/>
            </Grid>
            <Grid Grid.Row="2">
                <Grid Margin="20,10,20,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="DESCRIPTION" Grid.Column="0" FontSize="12" FontWeight="ExtraLight" />
                    <TextBlock Text="Quantity" Grid.Column="1" FontSize="12" FontWeight="ExtraLight" HorizontalAlignment="Center"/>
                    <TextBlock Text="Price" Grid.Column="2" FontSize="12" FontWeight="ExtraLight" HorizontalAlignment="Center"/>
                    <TextBlock Text="TAX" Grid.Column="3" FontSize="12" FontWeight="ExtraLight" HorizontalAlignment="Center"/>
                    <TextBlock Text="Amount (LKR)" Grid.Column="4" FontSize="12" FontWeight="ExtraLight" HorizontalAlignment="Right"/>
                </Grid>
                <Rectangle Fill="Black" Height="1" Opacity="0.5" VerticalAlignment="Bottom" Margin="20,00,20,0"/>
            </Grid>
            <Grid Grid.Row="3">
                <ListView ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,15,11,22">
                    <ListViewItem>
                        <Grid Margin="15,0,0,0" Width="480">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Website design" Grid.Column="0"/>
                            <TextBlock Text="2" Grid.Column="1" HorizontalAlignment="Center"/>
                            <TextBlock Text="10" Grid.Column="2" HorizontalAlignment="Center"/>
                            <TextBlock Text="10%" Grid.Column="3" HorizontalAlignment="Center"/>
                            <TextBlock Text="40.00" Grid.Column="4" HorizontalAlignment="Center" Foreground="#FF62013C"/>
                        </Grid>
                    </ListViewItem>
                </ListView>
                <Rectangle Fill="Black" Height="1" Opacity="0.5" VerticalAlignment="Bottom" Margin="20,0,20,0"/>
            </Grid>
            <Grid Grid.Row="4" Margin="0,0,0,35">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.8*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,15,0,10">
                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                            <TextBlock Text="Subtotal :" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,25,0">
                            <TextBlock Text="LKR 0.00" FontSize="14"  />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1">
                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                            <TextBlock Text="Discount(10%) :" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,25,0">
                            <TextBlock Text="LKR 0.00" FontSize="14"  />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="2">
                        <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="0,10,0,0">
                            <TextBlock Text="Shipping Cost :" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right" Margin="0,10,25,0">
                            <TextBlock Text="LKR 0.00" FontSize="14"  />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="3">
                        <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="0,10,0,0">
                            <TextBlock Text="Sales Tax :" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right" Margin="0,10,25,0">
                            <TextBlock Text="LKR 0.00" FontSize="14"  />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="4">
                        <Rectangle Fill="Black" Height="1" Opacity="0.5" VerticalAlignment="Bottom" Margin="0,0,25,0"/>
                        <Rectangle Fill="Black" Height="1" Opacity="0.5" VerticalAlignment="Top" Margin="0,7,25,0"/>
                        <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="0,10,0,0">
                            <TextBlock Text="Total :" FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right" Margin="0,10,25,0">
                            <TextBlock Text="LKR 0.00" FontSize="14" FontWeight="Bold" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="5">
                        <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="0,10,0,0">
                            <TextBlock Text="Amount Paid:" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right" Margin="0,10,25,0">
                            <TextBlock Text="LKR 0.00" FontSize="14"  />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="6">
                        <Rectangle Fill="Black" Height="1" Opacity="0.5" VerticalAlignment="Bottom" Margin="0,0,25,0"/>
                        <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="0,10,0,0">
                            <TextBlock Text="Balance Due:" FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right" Margin="0,10,25,0">
                            <TextBlock Text="LKR 0.00" FontSize="14" FontWeight="Bold"  />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
            <Grid Grid.Row="5">
                <Rectangle Fill="Black" Height="1" Margin="5 2" Opacity="0.5" Grid.Row="0" VerticalAlignment="Top"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <StackPanel Margin="20,10,0,0">
                            <TextBlock Text="Terms &amp; Conditions :" FontWeight="Bold" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="20,10,10,40">
                        <StackPanel>
                            <TextBlock 
                                 Text=" * All Spare and Electrical parts come with a 6-Month warranty."/>
                            <TextBlock 
                                 Text=" * Refunds or exchanges are accepted within 14 days with a valid receipt."/>
                            <TextBlock 
                                 Text=" * To Refund Items must be unused, in original packaging, and undamaged."/>
                            <TextBlock 
                                 Text=" * Electrical parts, custom orders, and opened fluids are Non-refundable."/>
                            <TextBlock 
                                 Text=" * Refunds will follow the original payment method."/>
                            <TextBlock 
                                 Text="*** (C) Saliya Auto Care ***" HorizontalAlignment="Center" Margin="0,20,0,0" FontSize="12.5"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>