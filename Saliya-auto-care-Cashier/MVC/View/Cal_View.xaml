        <UserControl.Resources>
        <Style x:Key="NumberButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="GrayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Gray"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="RedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Red"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="GreenButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Green"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="15,0,15,0" Background="#f0f0f0" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="" 
                       FontSize="24"
                       Margin="10" 
                       Grid.Column="0"
            />
            <Button Content="SKU" 
                    FontSize="20" 
                    Background="#4285F4" 
                    Foreground="White" 
                    Margin="0,2,2,2.5" 
                    Grid.Column="1"
                    Height="Auto"
            />
        </Grid>
        
        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <Button Content="7" Grid.Row="0" Grid.Column="0" Style="{StaticResource NumberButtonStyle}" Click="btn_error" />
            <Button Content="8" Grid.Row="0" Grid.Column="1" Style="{StaticResource NumberButtonStyle}"  Click="btn_success" />
            <Button Content="9" Grid.Row="0" Grid.Column="2" Style="{StaticResource NumberButtonStyle}"  Click="btn_info" />
            <Button Content="4" Grid.Row="1" Grid.Column="0" Style="{StaticResource NumberButtonStyle}" />
            <Button Content="5" Grid.Row="1" Grid.Column="1" Style="{StaticResource NumberButtonStyle}" />
            <Button Content="6" Grid.Row="1" Grid.Column="2" Style="{StaticResource NumberButtonStyle}" />
            <Button Content="1" Grid.Row="2" Grid.Column="0" Style="{StaticResource NumberButtonStyle}" />
            <Button Content="2" Grid.Row="2" Grid.Column="1" Style="{StaticResource NumberButtonStyle}" />
            <Button Content="3" Grid.Row="2" Grid.Column="2" Style="{StaticResource NumberButtonStyle}" />
            <Button Content="00" Grid.Row="3" Grid.Column="0" Style="{StaticResource NumberButtonStyle}" />
            <Button Content="0" Grid.Row="3" Grid.Column="1" Style="{StaticResource NumberButtonStyle}" />
            <Button Content="@" Grid.Row="3" Grid.Column="2" Style="{StaticResource NumberButtonStyle}" Click="btn_member"/>
            <Button Content="Refund" Grid.Row="0" Grid.Column="3" Style="{StaticResource GrayButtonStyle}" />
            <Button Content="Print" Grid.Row="1" Grid.Column="3" Style="{StaticResource GrayButtonStyle}" />
            <Button Content="+" Grid.Row="2" Grid.Column="3" Style="{StaticResource RedButtonStyle}" />
            <Button Content="Cash" Grid.Row="3" Grid.Column="3" Style="{StaticResource GreenButtonStyle}" />
        </Grid>
    </Grid>
