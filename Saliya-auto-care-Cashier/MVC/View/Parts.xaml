<UserControl x:Class="Saliya_auto_care_Cashier.MVC.View.Parts"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Saliya_auto_care_Cashier.MVC.View"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <StackPanel Grid.Row="0" Background="#2196F3" >
            <TextBlock Text="Parts Management" FontSize="24" Foreground="White" FontWeight="Bold"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Scanner and Search -->
            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <!-- Scanner Section -->
                <GroupBox Header="Barcode Scanner" Padding="10">
                    <StackPanel>
                        <Border BorderBrush="Gray" BorderThickness="1" Height="150" Margin="0,0,0,10">
                            <Image x:Name="ScannerPreview" Stretch="UniformToFill"/>
                        </Border>
                        <TextBox x:Name="BarcodeInput" Margin="0,5" 
                                 KeyDown="BarcodeInput_KeyDown"/>
                        <Button Content="Start Scanner" Margin="0,5" 
                                Background="#4CAF50" Foreground="White"
                                Click="StartScanner_Click"/>
                    </StackPanel>
                </GroupBox>

                <!-- Search Section -->
                <GroupBox Header="Search Parts" Margin="0,20,0,0" Padding="10">
                    <StackPanel>
                        <TextBox x:Name="SearchBox" Margin="0,5"
                                 />
                        <ComboBox x:Name="CategoryFilter" Margin="0,5"
                                  />
                        <Button Content="Search" Margin="0,5"
                                Background="#2196F3" Foreground="White"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>

            <!-- Right Panel - Parts List and Details -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Parts DataGrid -->
                <DataGrid x:Name="PartsGrid" Grid.Row="0" AutoGenerateColumns="False" 
                          SelectionMode="Single" SelectionChanged="PartsGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Part ID" Binding="{Binding PartId}" Width="100"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="150"/>
                        <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="80"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="100"/>
                        <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Part Details Section -->
                <GroupBox Grid.Row="1" Header="Part Details" Margin="0,10,0,0" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0" Margin="5">
                            <TextBlock Text="Part Name:" FontWeight="Bold"/>
                            <TextBox x:Name="PartName" IsReadOnly="True"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="0" Margin="5">
                            <TextBlock Text="Part Number:" FontWeight="Bold"/>
                            <TextBox x:Name="PartNumber" IsReadOnly="True"/>
                        </StackPanel>

                        <StackPanel Grid.Column="0" Grid.Row="1" Margin="5">
                            <TextBlock Text="Category:" FontWeight="Bold"/>
                            <TextBox x:Name="Category" IsReadOnly="True"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="1" Margin="5">
                            <TextBlock Text="Stock Level:" FontWeight="Bold"/>
                            <TextBox x:Name="StockLevel" IsReadOnly="True"/>
                        </StackPanel>

                        <StackPanel Grid.Column="0" Grid.Row="2" Margin="5">
                            <TextBlock Text="Price:" FontWeight="Bold"/>
                            <TextBox x:Name="Price" IsReadOnly="True"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="2" Margin="5">
                            <TextBlock Text="Location:" FontWeight="Bold"/>
                            <TextBox x:Name="Location" IsReadOnly="True"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>