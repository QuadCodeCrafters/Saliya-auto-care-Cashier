<UserControl x:Class="Saliya_auto_care_Cashier.MVC.View.Overviews"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Saliya_auto_care_Cashier.MVC.View"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:gmap="clr-namespace:GMap.NET.WindowsPresentation;assembly=GMap.NET.WindowsPresentation"
             mc:Ignorable="d">
    <Grid>
        <materialDesign:Card UniformCornerRadius="12"
                             Background="#F5F5F5"
                             Margin="10"
                             materialDesign:ShadowAssist.ShadowDepth="Depth2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="500"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid Background="#F5F5F5">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>

                            <materialDesign:Card UniformCornerRadius="12"
                                                     Background="White"
                                                     Margin="20,20,15,20"
                                                     materialDesign:ShadowAssist.ShadowDepth="Depth2">

                                <StackPanel Grid.Column="0" Margin="10" Background="White">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="Ongoing Pickups" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" />

                                        <!-- Pickup List -->
                                        <StackPanel Grid.Row="1">
                                            <Grid>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">

                                                    <StackPanel>
                                                        <Button x:Name="ShipmentButton1"
                                                                    Padding="0"
                                                                    Height="80"
                                                                    Background="White"
                                                                    BorderThickness="2"
                                                                    BorderBrush="White"
                                                                    Margin="0,0,0,10"
                                                                    Click="Shipment_MouseDown">
                                                            <Grid>

                                                            </Grid>
                                                        </Button>
                                                        
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </materialDesign:Card>

                            <materialDesign:Card Grid.Column="1"
                                                 UniformCornerRadius="12"
                                                 Background="White"
                                                 Margin="10,20,10,20"
                                                 materialDesign:ShadowAssist.ShadowDepth="Depth2">
                                <StackPanel Grid.Column="1" Margin="10" Background="White">
                                    <TextBlock Text="On the Way" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" />
                                    <materialDesign:Card UniformCornerRadius="12"
                                                                 Background="White"
                                                                 Margin="5"
                                                                 materialDesign:ShadowAssist.ShadowDepth="Depth1">
                                        <Border Background="#EAEAEA" Height="275" CornerRadius="10">
                                            <ScrollViewer VerticalScrollBarVisibility="Disabled">
                                                <gmap:GMapControl x:Name="MapControl" Zoom="13" MaxZoom="24" MinZoom="1" />
                                            </ScrollViewer>
                                        </Border>
                                    </materialDesign:Card>

                                    <StackPanel Margin="0,20,0,0">
                                        
                                        
                                    </StackPanel>
                                </StackPanel>
                            </materialDesign:Card>
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="1">
                        <materialDesign:Card UniformCornerRadius="12"
                             Background="White"
                             Margin="20,20,15,20"
                             materialDesign:ShadowAssist.ShadowDepth="Depth2">
                            
                            
                            
                        </materialDesign:Card>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </materialDesign:Card>
    </Grid>
</UserControl>
