<UserControl x:Class="Saliya_auto_care_Cashier.MVC.View.Overviews"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Saliya_auto_care_Cashier.MVC.View"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:gmap="clr-namespace:GMap.NET.WindowsPresentation;assembly=GMap.NET.WindowsPresentation"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- Resources for ScrollViewer styling -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ScrollViewerStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <materialDesign:Card UniformCornerRadius="12"
                             Background="White"
                             Margin="10"
                             materialDesign:ShadowAssist.ShadowDepth="Depth2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Border Background="Pink" CornerRadius="15" Margin="20">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid Background="#F5F5F5" Margin="10">
                                    <!-- Main Layout -->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="3*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Section -->
                                    <StackPanel Grid.Column="0" Margin="10" Background="White">
                                        <TextBlock Text="Ongoing Delivery" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" />

                                        <!-- Shipment List -->
                                        <StackPanel>
                                            <!-- Shipment Item 1 -->
                                            <Button x:Name="ShipmentButton1"
                                                    Padding="0"
                                                    Height="80"
                                                    Background="White"
                                                    BorderThickness="2"
                                                    BorderBrush="White"
                                                    Margin="0,0,0,10"
                                                    Click="Shipment_MouseDown">
                                                <Grid>
                                                    <!-- button inside-->
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60*" />
                                                        <ColumnDefinition Width="40*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                                                        <Image Width="50" Height="50" Margin="0,0,10,0" />
                                                        <StackPanel>
                                                            <TextBlock Text="Shipment Number" FontWeight="Bold" />
                                                            <TextBlock Text="#001234ABCD" FontSize="16" />
                                                            <TextBlock Text="87 Wern Ddu Lane ➝ 15 Vicar Lane" Foreground="Gray" FontSize="12" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Ellipse Width="10" Height="10" Fill="Green" VerticalAlignment="Center" Grid.Column="1" HorizontalAlignment="Right" />
                                                </Grid>
                                            </Button>

                                            <!-- Shipment Item 2 -->
                                            <Button x:Name="ShipmentButton2"
                                                    Padding="0"
                                                    Background="White"
                                                    BorderThickness="2"
                                                    Height="80"
                                                    BorderBrush="White"
                                                    Margin="0,0,0,10"
                                                    Click="Shipment_MouseDown">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60*" />
                                                        <ColumnDefinition Width="40*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                                                        <Image Width="50" Height="50" Margin="0,0,10,0" />
                                                        <StackPanel>
                                                            <TextBlock Text="Shipment Number" FontWeight="Bold" />
                                                            <TextBlock Text="#001234EFGH" FontSize="16" />
                                                            <TextBlock Text="40 Broomfield Place ➝ 44 Helland Bridge" Foreground="Gray" FontSize="12" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Ellipse Width="10" Height="10" Fill="Green" VerticalAlignment="Center" Grid.Column="1" HorizontalAlignment="Right" />
                                                </Grid>
                                            </Button>

                                            <!-- Add more shipment items as needed -->
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Right Section -->
                                    <StackPanel Grid.Column="1" Margin="10" Background="White">
                                        <TextBlock Text="On the Way" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" />
                                        <!-- Map Section -->
                                        <Border Background="#EAEAEA" Height="200" CornerRadius="10">
                                            <gmap:GMapControl x:Name="MapControl" Zoom="13" MaxZoom="24" MinZoom="1" />
                                        </Border>

                                        <!-- Shipment Details -->
                                        <StackPanel Margin="0,20,0,0">
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Category:" FontWeight="Bold" Grid.Column="0" Margin="0,0,10,0"/>
                                                <TextBlock Text="Electronic" Grid.Column="1"/>
                                            </Grid>
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Distance:" FontWeight="Bold" Grid.Column="0" Margin="0,0,10,0"/>
                                                <TextBlock Text="60.41 km" Grid.Column="1"/>
                                            </Grid>
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Estimation:" FontWeight="Bold" Grid.Column="0" Margin="0,0,10,0"/>
                                                <TextBlock Text="1d 16h" Grid.Column="1"/>
                                            </Grid>
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Weight:" FontWeight="Bold" Grid.Column="0" Margin="0,0,10,0"/>
                                                <TextBlock Text="25kg" Grid.Column="1"/>
                                            </Grid>
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Fee:" FontWeight="Bold" Grid.Column="0" Margin="0,0,10,0"/>
                                                <TextBlock Text="$1,050" Grid.Column="1"/>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Border Background="Yellow" CornerRadius="15" Margin="20">
                            <Button Height="80">
                                Confirm Delivery
                            </Button>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </materialDesign:Card>
    </Grid>
</UserControl>
