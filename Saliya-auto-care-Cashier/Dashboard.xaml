<Window x:Class="Saliya_auto_care_Cashier.Dashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Saliya_auto_care_Cashier"
        mc:Ignorable="d"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="600"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="Blue" Grid.Row="0">
        
        </Border>
        <Border Background="LightBlue" Grid.Row="1">
 
        </Border>
        <Border Background="White" Grid.Row="2">
 
        </Border>
        <StackPanel Grid.Row="2">
            <Button Height="40" Width="120" Margin="20" FontSize="25" Click="btn_home">
                Click
            </Button>
        </StackPanel>
        <Frame Grid.Row="1"
               Name="fContainer"
               Margin="10,10,10,10"
               NavigationUIVisibility="Hidden">
        </Frame>

    </Grid>
</Window>
