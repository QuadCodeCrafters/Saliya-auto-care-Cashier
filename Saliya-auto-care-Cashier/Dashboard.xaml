<Window x:Class="Saliya_auto_care_Cashier.Dashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Saliya_auto_care_Cashier"
        mc:Ignorable="d"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="630"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="Blue" Grid.Row="0">
        </Border>

        <Border Background="LightBlue" Grid.Row="1">
        </Border>

        <Border Background="White" Grid.Row="2">
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="Customers" Width="100" Height="40" Click="btn_customer"/>
            <Button Content="Register" Margin="10" Width="100" Height="40" Click="btn_registor"/>
            <Button Content="Inventory" Width="100" Height="40"/>
            <Button Content="Paint Jobs"  Margin="10"  Width="100" Height="40"/>
            <Button Content="Vehicle Services" Width="135" Height="40"/>
            <Button Content="Vehicle Repairs"  Margin="10"  Width="135" Height="40"/>
            <Button Content="Spare Parts" Width="125" Height="40"/>
            <Button Content="Delivary Service"  Margin="10"  Width="135" Height="40"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="8" CornerRadius="10" BorderThickness="1">
            <Frame Name="fContainer" NavigationUIVisibility="Hidden"/>
        </Border>


    </Grid>
</Window>
