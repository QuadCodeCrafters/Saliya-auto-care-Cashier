<Window x:Class="Saliya_auto_care_Cashier.Dashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:Saliya_auto_care_Cashier"
        mc:Ignorable="d"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize">
    <Grid>
        <materialDesign:DialogHost x:Name="PermissionDialogHost" BorderBrush="{DynamicResource MaterialDesignDivider}">
            <materialDesign:DialogHost.DialogContent>

                <Grid Width="350" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="15">
                        <materialDesign:PackIcon Kind="CloseBox" Foreground="{StaticResource PrimaryHueMidBrush}" Width="60" Height="60" />
                        <TextBlock  Foreground="{DynamicResource MaterialDesignBody}" Width="220" Margin="15 5" TextWrapping="Wrap" FontSize="18" >
                                Do you want to go home?
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="15">
                        <Button Foreground="{DynamicResource MaterialDesignBody}"  Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Style="{DynamicResource MaterialDesignFlatButton}" Margin="4" VerticalAlignment="Center" Click="Button_Click">
                            Yes
                        </Button>
                        <Button Foreground="{DynamicResource MaterialDesignBody}"  Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Style="{DynamicResource MaterialDesignFlatButton}" Margin="4" VerticalAlignment="Center">
                            No
                        </Button>
                    </StackPanel>
                </Grid>
            </materialDesign:DialogHost.DialogContent>
            <Grid>
                <materialDesign:DialogHost x:Name="MemberDialogHost" BorderBrush="{DynamicResource MaterialDesignDivider}">
                    <materialDesign:DialogHost.DialogContent>

                        <Grid Width="450" Height="250" HorizontalAlignment="Center" VerticalAlignment="Center">
 
                        </Grid>
                    </materialDesign:DialogHost.DialogContent>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Background="Blue" Grid.Row="0" Height="40">
                        </Border>
                        <Border Background="LightBlue" Grid.Row="1">
                        </Border>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Background="Transparent" BorderBrush="Transparent" Height="70" Width="90" Command="{x:Static materialDesign:DialogHost.OpenDialogCommand}" CommandTarget="{Binding ElementName=PermissionDialogHost}" Margin="-200,0,0,0">
                                <Image Source="/Images/Home.png" Width="50" Height="50" Cursor="Hand">
                                    <Image.ToolTip>
                                        <ToolTip Background="White" Foreground="DarkBlue" BorderBrush="DarkBlue" BorderThickness="1" Margin="15">
                                            <TextBlock Text="Logout" FontWeight="Bold" FontSize="15"/>
                                        </ToolTip>
                                    </Image.ToolTip>
                                </Image>
                            </Button>
                            <Button Content="Register" Width="100" Height="40" Click="btn_registor"/>
                            <Button Content="Vehicle History" Width="130" Margin="10 0" Height="40" Click="btn_VehicleHistory"/>
                            <Button Content="Inventory" Width="100" Height="40" Click="btn_Inventory"/>
                            <Button Content="Paint Jobs" Width="100" Height="40" Margin="10 0" Click="btn_Paint_Jobs"/>
                            <Button Content="Vehicle Services" Width="135" Height="40" Click="btn_Vehicle_Services"/>
                            <Button Content="Vehicle Repairs" Width="135" Height="40" Margin="10 0" Click="btn_Vehicle_Repairs"/>
                            <Button Content="Spare Parts" Width="125" Height="40" Click="btn_Spare_Parts"/>
                            <Button Content="Carrier Service" Width="135" Height="40" Margin="10 0" Click="btn_Delivary_Service"/>
                        </StackPanel>
                        <Border Grid.Row="1" Margin="5" CornerRadius="10" BorderThickness="1">
                            <Frame Name="fContainer" NavigationUIVisibility="Hidden"/>
                        </Border>
                    </Grid>
                </materialDesign:DialogHost>
            </Grid>
        </materialDesign:DialogHost>
    </Grid>
</Window>
