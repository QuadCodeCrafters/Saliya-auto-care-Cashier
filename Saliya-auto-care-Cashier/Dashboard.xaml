<Window x:Class="Saliya_auto_care_Cashier.Dashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:Saliya_auto_care_Cashier" 
        xmlns:local1="clr-namespace:Saliya_auto_care_Cashier.MVC.View"
        mc:Ignorable="d"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize">
    <Grid>
        <materialDesign:DialogHost x:Name="PermissionDialogHost" BorderBrush="{DynamicResource MaterialDesignDivider}">
            <materialDesign:DialogHost.DialogContent>

                <Grid Width="350" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="15">
                        <materialDesign:PackIcon Kind="CloseBox" Foreground="{StaticResource PrimaryHueMidBrush}" Width="60" Height="60" />
                        <TextBlock  Foreground="{DynamicResource MaterialDesignBody}" Width="220" Margin="15 5" TextWrapping="Wrap" FontSize="18" >
                                Do you want to go home?
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="15">
                        <Button Foreground="{DynamicResource MaterialDesignBody}"  Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Style="{DynamicResource MaterialDesignFlatButton}" Margin="4" VerticalAlignment="Center" Click="Button_Click">
                            Yes
                        </Button>
                        <Button Foreground="{DynamicResource MaterialDesignBody}"  Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Style="{DynamicResource MaterialDesignFlatButton}" Margin="4" VerticalAlignment="Center">
                            No
                        </Button>
                    </StackPanel>
                </Grid>
            </materialDesign:DialogHost.DialogContent>
            <Grid>
                <!--The message box of Loyality Unlock-->
                <materialDesign:DialogHost x:Name="MemberDialogHost" BorderBrush="{DynamicResource MaterialDesignDivider}">
                    <materialDesign:DialogHost.DialogContent>
                        <Grid Width="500" Height="310" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border BorderBrush="LightBlue" BorderThickness="5,5,5,5">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="0.5*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <StackPanel Margin="15,20,0,0" HorizontalAlignment="Left">
                                            <Image Source="/Images/loyal.PNG" Width="100"/>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,30,0">
                                            <TextBlock Text="Welcome to Loyalty Unlock" FontSize="15" Foreground="Black" FontWeight="Bold"/>
                                        </StackPanel>
                                        <Rectangle Fill="Red" Height="1.5" Opacity="0.5" VerticalAlignment="Bottom" Margin="20,00,20,0"/>
                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <StackPanel HorizontalAlignment="Left" Margin="40,25,0,0">
                                            <TextBlock Text="Example: 1234567 "/>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Right" Margin="0,25,-20,0">
                                            <TextBlock x:Name="IDError" TextWrapping="Wrap" Text="" Width="260" Height="27" TextAlignment="Center" Foreground="Red"/>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Right" Margin="0,25,0,0">
                                            <TextBlock x:Name="Cusname" TextWrapping="Wrap" Text="" Width="260" Height="40" TextAlignment="Center" Foreground="Green"/>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Left" Margin="40,70,0,0">
                                            <TextBox x:Name="txtloyalid" 
                                                     TextChanged="txtloyalid_TextChanged" 
                                                     Width="390" 
                                                     Height="60"
                                                     FontSize="17.5" 
                                                     materialDesign:HintAssist.Hint="Enter The Vehicle Number" 
                                                     BorderThickness="2" 
                                                     BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}">
                                                <TextBox.Triggers>
                                                    <EventTrigger RoutedEvent="TextBox.GotFocus">
                                                        <BeginStoryboard Storyboard="{StaticResource ShakeAnimation}"/>
                                                    </EventTrigger>
                                                </TextBox.Triggers>
                                            </TextBox>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,15" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Foreground="{DynamicResource MaterialDesignBody}" Style="{DynamicResource MaterialDesignFlatButton}" Margin="0,0,140,0" Click="addbtn_click">
                                                Add
                                            </Button>
                                            <Button Foreground="{DynamicResource MaterialDesignBody}"  Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Style="{DynamicResource MaterialDesignFlatButton}" Click="addbtn_cancel">
                                                Go Back
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </materialDesign:DialogHost.DialogContent>
                    <Grid>
                        <!--Schrdule Pickup message box-->
                        <materialDesign:DialogHost x:Name="SchedulePickupDialogHost" BorderBrush="{DynamicResource MaterialDesignDivider}">
                            <materialDesign:DialogHost.DialogContent>
                                <Grid Width="700" Height="400"  HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border BorderBrush="LightBlue" BorderThickness="5,5,5,5" >
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="60"/>
                                                <RowDefinition Height="200"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,20,0,0">
                                                <TextBlock Text="Schedule A Pickup" FontSize="18" Foreground="Black" FontWeight="Bold"/>
                                            </StackPanel>
                                            <Button Margin="0,20,40,0" Background="#509ea3" Width="160" Height="38" Foreground="White" FontSize="15" FontWeight="Bold" Click="btn_availability" HorizontalAlignment="Right">
                                                Check Availability
                                            </Button>
                                                <Grid Grid.Row="1" Margin="0,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="txtcusname" 
                                                         Margin="0,-35,0,0"
                                                         Width="300" 
                                                         Height="60"
                                                         FontSize="17.5" 
                                                         materialDesign:HintAssist.Hint="Enter The Customer Name" 
                                                         BorderThickness="2" 
                                                         BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                                         Style="{StaticResource MaterialDesignOutlinedTextBox}">
                                                            <TextBox.Triggers>
                                                                <EventTrigger RoutedEvent="TextBox.GotFocus">
                                                                    <BeginStoryboard Storyboard="{StaticResource ShakeAnimation}"/>
                                                                </EventTrigger>
                                                            </TextBox.Triggers>
                                                </TextBox>

                                                <TextBox Grid.Column="1"
                                                         x:Name="txtcusmobile" 
                                                         Margin="0,-35,0,0"
                                                         Width="300" 
                                                         Height="60"
                                                         FontSize="17.5" 
                                                         materialDesign:HintAssist.Hint="Enter The Mobile Number" 
                                                         BorderThickness="2" 
                                                         BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                                         Style="{StaticResource MaterialDesignOutlinedTextBox}">
                                                    <TextBox.Triggers>
                                                        <EventTrigger RoutedEvent="TextBox.GotFocus">
                                                            <BeginStoryboard Storyboard="{StaticResource ShakeAnimation}"/>
                                                        </EventTrigger>
                                                    </TextBox.Triggers>
                                                </TextBox>
                                                <ComboBox VerticalAlignment="Bottom"
                                                          x:Name="cmbdrivername" 
                                                          Margin="0,0,0,-10"
                                                          Width="300" 
                                                          Height="60"
                                                          FontSize="17.5" 
                                                          materialDesign:HintAssist.Hint="Select A Driver" 
                                                          BorderThickness="2" 
                                                          BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                                          Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                                    <ComboBox.Triggers>
                                                        <EventTrigger RoutedEvent="ComboBox.GotFocus">
                                                            <BeginStoryboard Storyboard="{StaticResource ShakeAnimation}"/>
                                                        </EventTrigger>
                                                    </ComboBox.Triggers>
                                                </ComboBox>

                                                <ComboBox VerticalAlignment="Bottom" Grid.Column="1"
                                                          x:Name="cmbcarriername" 
                                                          Width="300" 
                                                          Margin="0,0,0,-10"
                                                          Height="60"
                                                          FontSize="17.5" 
                                                          materialDesign:HintAssist.Hint="Select A Carrier" 
                                                          BorderThickness="2" 
                                                          BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                                          Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                                    <ComboBox.Triggers>
                                                        <EventTrigger RoutedEvent="ComboBox.GotFocus">
                                                            <BeginStoryboard Storyboard="{StaticResource ShakeAnimation}"/>
                                                        </EventTrigger>
                                                    </ComboBox.Triggers>
                                                </ComboBox>

                                            </Grid>
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Foreground="{DynamicResource MaterialDesignBody}" Style="{DynamicResource MaterialDesignFlatButton}" Margin="0,0,-50,0" FontWeight="Bold" FontSize="17" Width="120" Height="40" Click="ButtonSchedule_click">
                                                    Schedule
                                                </Button>
                                                <Button Grid.Column="1" Foreground="{DynamicResource MaterialDesignBody}"  Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Style="{DynamicResource MaterialDesignFlatButton}" FontWeight="Bold" FontSize="17" Margin="-100,0,0,0" Height="40" Width="100" Click="goback">
                                                    Go Back
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </materialDesign:DialogHost.DialogContent>
                            <Grid>
                                <!--Clear All message box for menu-->
                                <materialDesign:DialogHost x:Name="ClearAllDialogHost" BorderBrush="{DynamicResource MaterialDesignDivider}">
                                    <materialDesign:DialogHost.DialogContent>
                                        <Grid Width="350" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="15">
                                                <materialDesign:PackIcon Kind="InfoCircle" Foreground="{StaticResource PrimaryHueMidBrush}" Width="60" Height="60" Margin="0,10,0,0" />
                                                <TextBlock Foreground="{DynamicResource MaterialDesignBody}" Width="230"  Margin="15,15,0,0" TextWrapping="Wrap" FontSize="18">
                                                           Do you want to clear all? This action can't be undone.
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="15">
                                                <Button Foreground="{DynamicResource MaterialDesignBody}"  Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Style="{DynamicResource MaterialDesignFlatButton}" Margin="4" VerticalAlignment="Center" Click="Buttondashboardclear_Click">
                                                    Yes
                                                </Button>
                                                <Button Foreground="{DynamicResource MaterialDesignBody}"  Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Style="{DynamicResource MaterialDesignFlatButton}" Margin="4" VerticalAlignment="Center">
                                                    No
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </materialDesign:DialogHost.DialogContent>
                                    <Grid>
                                        <!--Clear All message box for Hisroty View-->
                                        <materialDesign:DialogHost x:Name="ClearAllDialogHostforhistory" BorderBrush="{DynamicResource MaterialDesignDivider}">
                                            <materialDesign:DialogHost.DialogContent>
                                                <Grid Width="350" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Margin="15">
                                                        <materialDesign:PackIcon Kind="InfoCircle" Foreground="{StaticResource PrimaryHueMidBrush}" Width="60" Height="60" Margin="0,10,0,0"/>
                                                        <TextBlock Foreground="{DynamicResource MaterialDesignBody}" Width="230" Margin="15,15,0,0" TextWrapping="Wrap" FontSize="18">
                                                           Do you want to clear all? This action can't be undone.
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="15">
                                                        <Button Foreground="{DynamicResource MaterialDesignBody}"  Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Style="{DynamicResource MaterialDesignFlatButton}" Margin="4" VerticalAlignment="Center" Click="Buttonhistoryclear_Click">
                                                            Yes
                                                        </Button>
                                                        <Button Foreground="{DynamicResource MaterialDesignBody}"  Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Style="{DynamicResource MaterialDesignFlatButton}" Margin="4" VerticalAlignment="Center">
                                                            No
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </materialDesign:DialogHost.DialogContent>
                                            <Grid>
                                                <!--Clear All message box for Register View-->
                                                <materialDesign:DialogHost x:Name="ClearRegisterDialogHost" BorderBrush="{DynamicResource MaterialDesignDivider}">
                                                    <materialDesign:DialogHost.DialogContent>
                                                        <Grid Width="350" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Margin="15">
                                                                <materialDesign:PackIcon Kind="InfoCircle" Foreground="{StaticResource PrimaryHueMidBrush}" Width="60" Height="60" Margin="0,10,0,0"/>
                                                                <TextBlock Foreground="{DynamicResource MaterialDesignBody}" Width="230" Margin="15,15,0,0" TextWrapping="Wrap" FontSize="18">
                                                                                          Do you want to clear all? This action can't be undone.
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="15">
                                                                <Button Foreground="{DynamicResource MaterialDesignBody}"  Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Style="{DynamicResource MaterialDesignFlatButton}" Margin="4" VerticalAlignment="Center" Click="ButtonRegisterclear_Click">
                                                                    Yes
                                                                </Button>
                                                                <Button Foreground="{DynamicResource MaterialDesignBody}"  Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Style="{DynamicResource MaterialDesignFlatButton}" Margin="4" VerticalAlignment="Center">
                                                                    No
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </materialDesign:DialogHost.DialogContent>
                                                    <Grid>
                                                        <!--Message box for Custom Button-->
                                                       <materialDesign:DialogHost x:Name="CustomButtonDialogHost" BorderBrush="{DynamicResource MaterialDesignDivider}">
                                                            <materialDesign:DialogHost.DialogContent>
                                                                <Grid Width="620" Height="400" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <Grid>
                                                                        <Grid.RowDefinitions>
                                                                            
                                                                        </Grid.RowDefinitions>
                                                                    </Grid>
                                                                    <Button Grid.Column="1" Foreground="{DynamicResource MaterialDesignBody}"  Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Style="{DynamicResource MaterialDesignFlatButton}" FontWeight="Bold" FontSize="17" Margin="-100,0,0,0" Height="40" Width="100" Click="goback">
                                                                        Go Back
                                                                    </Button>
                                                                </Grid>
                                                            </materialDesign:DialogHost.DialogContent>
                                                            <Grid>
                                                                <!--Message box for Refund Button-->
                                                                <materialDesign:DialogHost x:Name="RefundButtonDialogHost" BorderBrush="{DynamicResource MaterialDesignDivider}">
                                                                    <materialDesign:DialogHost.DialogContent >
                                                                        <Grid Width="350" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                            <StackPanel Orientation="Horizontal" Margin="15">
                                                                                <materialDesign:PackIcon Kind="InfoCircle" Foreground="{StaticResource PrimaryHueMidBrush}" Width="60" Height="60" Margin="0,10,0,0"/>
                                                                                <TextBlock Foreground="{DynamicResource MaterialDesignBody}" Width="230" Margin="15,15,0,0" TextWrapping="Wrap" FontSize="18">
                                                                                              Add the Refund Stuff.
                                                                                </TextBlock>
                                                                            </StackPanel>
                                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="15">
                                                                                <Button Foreground="{DynamicResource MaterialDesignBody}"  Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Style="{DynamicResource MaterialDesignFlatButton}" Margin="4" VerticalAlignment="Center">
                                                                                    Yes
                                                                                </Button>
                                                                                <Button Foreground="{DynamicResource MaterialDesignBody}"  Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Style="{DynamicResource MaterialDesignFlatButton}" Margin="4" VerticalAlignment="Center">
                                                                                    No
                                                                                </Button>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </materialDesign:DialogHost.DialogContent>
                                                                    <Grid>
                                                                        <!--Message box for History Button-->
                                                                        <materialDesign:DialogHost x:Name="HistoryButtonDialogHost" BorderBrush="{DynamicResource MaterialDesignDivider}">
                                                                            <materialDesign:DialogHost.DialogContent >
                                                                                <Grid Width="910" Height="550" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0">
                                                                                    <Grid>
                                                                                        <Grid.RowDefinitions>
                                                                                            <RowDefinition Height="Auto"/>
                                                                                            <RowDefinition Height="*"/>
                                                                                        </Grid.RowDefinitions>
                                                                                        <Grid Background="LightBlue">
                                                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,5">
                                                                                                <TextBlock Text="Bill History" FontSize="25" Foreground="Black" FontWeight="Bold"/>
                                                                                            </StackPanel>
                                                                                        </Grid>
                                                                                        <materialDesign:Card Grid.Row="1" UniformCornerRadius="15" 
                                                                                                             Background="{DynamicResource MaterialDesignPaper}"
                                                                                                             Margin="5"
                                                                                                             materialDesign:ShadowAssist.ShadowDepth="Depth3">

                                                                                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,50"  >
                                                                                                <DataGrid x:Name="HistoryDataGrid"
                                                                                                      HorizontalAlignment="Center" 
                                                                                                      Margin="0,0,0,0"
                                                                                                      Height="Auto"
                                                                                                      AutoGenerateColumns="False">
                                                                                                    <DataGrid.Columns>
                                                                                                        <DataGridTextColumn Header="Invoice ID" Binding="{Binding InvoiceID}" Width="*" />
                                                                                                        <DataGridTextColumn Header="Customer Name" Binding="{Binding Name}" Width="*" />
                                                                                                        <DataGridTextColumn Header="Vehicle" Binding="{Binding VehicleType}" Width="*" />
                                                                                                        <DataGridTextColumn Header="Vehicle ID" Binding="{Binding VehicleID}" Width="*" />
                                                                                                        <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount , StringFormat='Rs {0:N2}'}" Width="*" />
                                                                                                        <DataGridTextColumn Header="Amount Paid" Binding="{Binding PaidAmount ,StringFormat='Rs {0:N2}'  }" Width="*" />
                                                                                                        <DataGridTextColumn Header="Balance Due" Binding="{Binding Balance , StringFormat='Rs {0:N2}'}" Width="*" />
                                                                                                    </DataGrid.Columns>
                                                                                                </DataGrid>
                                                                                            </ScrollViewer>
                                                                                        </materialDesign:Card>
                                                                                        <Button Background="Transparent" BorderBrush="Transparent" Height="100" Width="120" Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Margin="0,0,0,0" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                                                                            <Image Source="/Images/Back.png" Width="70" Height="70" Cursor="Hand"/>
                                                                                        </Button>
                                                                                    </Grid>
                                                                                </Grid>
                                                                            </materialDesign:DialogHost.DialogContent>
                                                                            <Grid>
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="Auto"/>
                                                                                    <RowDefinition Height="*"/>
                                                                                    <RowDefinition Height="Auto"/>
                                                                                </Grid.RowDefinitions>

                                                                                <Border Background="Blue" Grid.Row="0" Height="40">
                                                                                </Border>
                                                                                <Border Background="LightBlue" Grid.Row="1">
                                                                                </Border>
                                                                                <Button Background="Transparent" BorderBrush="Transparent" Height="70" Width="90" Command="{x:Static materialDesign:DialogHost.OpenDialogCommand}" CommandTarget="{Binding ElementName=PermissionDialogHost}" Margin="0,0,0,0" Grid.Row="2" HorizontalAlignment="Left">
                                                                                    <Image Source="/Images/Home.png" Width="50" Height="50" Cursor="Hand">
                                                                                        <Image.ToolTip>
                                                                                            <ToolTip Background="White" Foreground="DarkBlue" BorderBrush="DarkBlue" BorderThickness="1" Margin="15">
                                                                                                <TextBlock Text="Logout" FontWeight="Bold" FontSize="15"/>
                                                                                            </ToolTip>
                                                                                        </Image.ToolTip>
                                                                                    </Image>
                                                                                </Button>
                                                                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                    <Button Content="Menu" Width="100" Height="40" Click="btn_menu" Margin="0,0,50,0"/>
                                                                                    <Button Content="Register" Width="100" Height="40" Click="btn_registor" Margin="0,0,50,0"/>
                                                                                    <Button Content="Vehicle History" Width="130" Margin="0,0,50,0" Height="40" Click="btn_VehicleHistory"/>
                                                                                    <Button Content="Inventory" Width="100" Height="40" Click="btn_Inventory" Margin="0,0,50,0"/>
                                                                                    <Button Content="Carrier Service" Width="135" Height="40" Click="btn_Delivary_Service" Margin="0,0,0,0"/>

                                                                                    <!-- <Button Content="Register" Width="100" Height="40" Click="btn_registor"/>
                                                                                    <Button Content="Vehicle History" Width="130" Margin="10 0" Height="40" Click="btn_VehicleHistory"/>
                                                                                    <Button Content="Inventory" Width="100" Height="40" Click="btn_Inventory"/>
                                                                                    <Button Content="Paint Jobs" Width="100" Height="40" Margin="10 0" Click="btn_Paint_Jobs"/>
                                                                                    <Button Content="Vehicle Services" Width="135" Height="40" Click="btn_Vehicle_Services"/>
                                                                                    <Button Content="Vehicle Repairs" Width="135" Height="40" Margin="10 0" Click="btn_Vehicle_Repairs"/>
                                                                                    <Button Content="Spare Parts" Width="125" Height="40" Click="btn_Spare_Parts"/>
                                                                                    <Button Content="Carrier Service" Width="135" Height="40" Margin="10 0" Click="btn_Delivary_Service"/ 
                                                                                    -->

                                                                                </StackPanel>
                                                                                <Border Grid.Row="1" Margin="5" CornerRadius="10" BorderThickness="1">
                                                                                    <Frame Name="fContainer" NavigationUIVisibility="Hidden"/>
                                                                                </Border>
                                                                            </Grid>
                                                                        </materialDesign:DialogHost>
                                                                    </Grid>
                                                                </materialDesign:DialogHost>
                                                            </Grid>
                                                       </materialDesign:DialogHost>
                                                    </Grid>
                                                </materialDesign:DialogHost>
                                            </Grid>
                                        </materialDesign:DialogHost>
                                    </Grid>
                                </materialDesign:DialogHost>
                            </Grid>
                        </materialDesign:DialogHost>
                    </Grid>
                </materialDesign:DialogHost>
            </Grid>
        </materialDesign:DialogHost>
    </Grid>
</Window>
